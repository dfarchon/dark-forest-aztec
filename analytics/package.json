{
  "name": "analytics",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "main": "src/cli.ts",
  "scripts": {
    "derive": "tsx src/cli.ts derive",
    "derive:rebuild": "tsx src/cli.ts derive --rebuild",
    "format": "prettier --write \"src/**/*.ts\" \"config/**/*.ts\" \"sync/**/*.ts\" \"analysis/**/*.ts\" \"test/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"config/**/*.ts\" \"sync/**/*.ts\" \"analysis/**/*.ts\" \"test/**/*.ts\"",
    "import": "tsx src/cli.ts import",
    "overview": "tsx src/cli.ts overview",
    "planets": "tsx src/cli.ts planets",
    "player": "tsx src/cli.ts player",
    "status": "tsx src/cli.ts status",
    "sync": "tsx src/cli.ts sync",
    "test": "node --test --experimental-transform-types analysis/*.test.ts test/*.test.ts"
  },
  "dependencies": {
    "@aztec-labs/aztec.js": "6.0.0",
    "@aztec-labs/constants": "6.0.0",
    "@aztec-labs/foundation": "6.0.0",
    "@aztec-labs/stdlib": "6.0.0",
    "@dfpunk/contracts": "workspace:*",
    "@dfpunk/indexer-core": "workspace:*",
    "better-sqlite3": "11.10.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "7.6.13",
    "prettier": "3.7.4",
    "typescript": "5.9.3"
  },
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": "24.22.1"
  }
}
