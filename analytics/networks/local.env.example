# Analytics network file. Set the node URL by hand.
# Do not copy contracts/networks/<name>.env; it contains account keys.
# pnpm --filter analytics import copies only contracts/deployments.
# Optional. Selects a universe other than deployments/local/latest.
# DEPLOYMENT_ID=

AZTEC_NODE_URL=http://localhost:8080

# Optional override of the imported deployment's start block.
# ANALYTICS_START_BLOCK=

# Optional. Defaults to data/<network>/<deployment-id>/events.db.
# ANALYTICS_DB=
