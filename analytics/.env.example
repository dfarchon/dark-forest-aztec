# Copy to .env. This file only selects the network; other keys here are ignored.
# AZTEC_NETWORK must match a file in networks/, for example local, testnet, or mainnet.
# networks/<AZTEC_NETWORK>.env is only the analytics node URL. Do not copy
# contracts/networks: those files contain account keys.
# Copy deployments with: pnpm --filter analytics import
# That copies contracts/deployments into analytics/deployments.
# The selected universe is deployments/<network>/latest, unless DEPLOYMENT_ID is set.
AZTEC_NETWORK=local
