# Copy to testnet.env and fill network fields in by hand.
# pnpm account:generate only appends ACCOUNT_* at the end; it does not overwrite existing lines.

AZTEC_NODE_URL=
ETHEREUM_HOST=

# Local PXE/wallet cache for this network. Relative to the contracts package root.
PXE_STORE_DIR=.store/testnet

# Prover defaults on for remote nodes.
# PROVER_ENABLED=true

FEE_PAYMENT_MODE=account
ACCOUNT_MIN_BALANCE_FJ=5

# ACCOUNT_SECRET_KEY and ACCOUNT_SIGNING_KEY are private keys.
ACCOUNT_SALT=
ACCOUNT_SECRET_KEY=
ACCOUNT_SIGNING_KEY=
ACCOUNT_ADDRESS=
