# Copy to local.env and fill network fields in by hand.
# pnpm account:generate only appends ACCOUNT_* at the end; it does not overwrite existing lines.

AZTEC_NODE_URL=http://localhost:8080
ETHEREUM_HOST=http://localhost:8545

# Local PXE/wallet cache. Relative to the contracts package root.
PXE_STORE_DIR=.store/local

# Prover defaults off on localhost. Set true to force it on.
# PROVER_ENABLED=false

FEE_PAYMENT_MODE=sponsored
ACCOUNT_MIN_BALANCE_FJ=5

# ACCOUNT_SECRET_KEY and ACCOUNT_SIGNING_KEY are private keys.
ACCOUNT_SALT=
ACCOUNT_SECRET_KEY=
ACCOUNT_SIGNING_KEY=
ACCOUNT_ADDRESS=
