{
    "name": "contracts",
    "version": "0.0.0",
    "description": "",
    "license": "",
    "author": "",
    "type": "module",
    "main": "index.js",
    "scripts": {
        "aztec:fmt": "nargo fmt --workspace",
        "aztec:fmt:check": "nargo fmt --workspace --check",
        "aztec:fmt:lint-staged": "node -e \"require('child_process').execSync('nargo fmt --workspace', {stdio:'inherit'})\"",
        "build": "pnpm build-contracts",
        "build-contracts": "pnpm clean && pnpm aztec:fmt && pnpm compile-contracts && pnpm codegen-contracts && pnpm copy-artifacts",
        "bytecode-check": "node --experimental-transform-types scripts/bytecode-check.ts",
        "clean": "del-cli dist node_modules target codegenCache.json",
        "clean-store": "del-cli .env pxe_data_* wallet_data_* ./scripts/pxe_data_* ./scripts/wallet_data_* ./scripts/.test-accounts.json .store",
        "codegen-contracts": "aztec codegen ./target -o ./target",
        "compile-contracts": "aztec compile",
        "configure": "node --experimental-transform-types scripts/configure.ts",
        "copy-artifacts": "mkdir -p scripts/artifacts && cp target/*.json target/*.ts scripts/artifacts",
        "deploy-contracts": "node --experimental-transform-types scripts/deploy.ts",
        "format": "pnpm run aztec:fmt & pnpm run scripts:fmt",
        "format:check": "pnpm run aztec:fmt:check & pnpm run scripts:fmt:check",
        "interact": "node --experimental-transform-types scripts/interact.ts",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "prettier": "prettier --write \"scripts/**/*.{ts,js,json}\"",
        "prettier:check": "prettier --check \"scripts/**/*.{ts,js,json}\"",
        "scripts:fmt": "pnpm run lint:fix && pnpm run prettier",
        "scripts:fmt:check": "pnpm prettier:check && pnpm lint",
        "start": "pnpm build && pnpm deploy-contracts && pnpm configure && pnpm sync-env-and-artifacts",
        "sync-env-and-artifacts": "node --experimental-transform-types scripts/sync-env-and-artifacts.ts",
        "test:moveProof": "pnpm exec tsx scripts/test-moveProof.ts",
        "timestamp-ticker": "node --experimental-transform-types scripts/timestamp-ticker.ts"
    },
    "dependencies": {
        "@dfpunk/utils": "workspace:*"
    },
    "devDependencies": {
        "@eslint/js": "9.39.2",
        "@types/node": "24.10.7",
        "eslint": "9.39.2",
        "eslint-config-prettier": "9.1.0",
        "eslint-plugin-simple-import-sort": "12.1.1",
        "globals": "16.5.0",
        "prettier": "3.7.4",
        "typescript": "5.9.3",
        "typescript-eslint": "8.53.0"
    },
    "packageManager": "pnpm@10.28.0"
}