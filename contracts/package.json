{
    "name": "dfpunk-contracts",
    "version": "0.1.0",
    "description": "",
    "license": "",
    "author": "",
    "main": "index.js",
    "scripts": {
        "clean": "rm -rf dist target codegenCache.json",
        "compile-contracts": "aztec compile",
        "codegen-contracts": "aztec codegen ./target -o ./target",
        "copy-artifacts": "mkdir -p scripts/artifacts && cp target/*.json target/*.ts scripts/artifacts",
        "build-contracts": "pnpm clean && pnpm compile-contracts && pnpm codegen-contracts && pnpm copy-artifacts",
        "deploy-contracts": "node --experimental-transform-types scripts/deploy.ts",
        "build": "pnpm build-contracts",
        "format": "prettier --write \"scripts/**/*.{ts,js,json}\"",
        "format:check": "prettier --check \"scripts/**/*.{ts,js,json}\""
    },
    "dependencies": {
        "@aztec/accounts": "3.0.0-devnet.20251212",
        "@aztec/aztec.js": "3.0.0-devnet.20251212",
        "@aztec/constants": "3.0.0-devnet.20251212",
        "@aztec/entrypoints": "3.0.0-devnet.20251212",
        "@aztec/foundation": "3.0.0-devnet.20251212",
        "@aztec/kv-store": "3.0.0-devnet.20251212",
        "@aztec/noir-contracts.js": "3.0.0-devnet.20251212",
        "@aztec/pxe": "3.0.0-devnet.20251212",
        "@aztec/stdlib": "3.0.0-devnet.20251212",
        "@aztec/test-wallet": "3.0.0-devnet.20251212",
        "@aztec/wallet-sdk": "3.0.0-devnet.20251212"
    },
    "devDependencies": {
        "@types/node": "^24.10.1",
        "prettier": "^3.2.5"
    },
    "packageManager": "pnpm@10.28.0"
}
