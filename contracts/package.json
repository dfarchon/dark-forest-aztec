{
    "name": "contracts",
    "version": "0.1.0",
    "description": "",
    "license": "",
    "author": "",
    "type": "module",
    "main": "index.js",
    "scripts": {
        "account:generate": "pnpm exec tsx scripts/runtime/generate-account.ts",
        "admin:balance": "pnpm exec tsx scripts/admin/balance.ts",
        "admin:config": "pnpm exec tsx scripts/admin/config.ts",
        "admin:preset": "pnpm exec tsx scripts/admin/preset.ts",
        "admin:tick": "pnpm exec tsx scripts/admin/tick.ts",
        "admin:zk-checks": "pnpm exec tsx scripts/admin/zk-checks.ts",
        "bootstrap": "pnpm exec tsx scripts/bootstrap/bootstrap.ts",
        "bootstrap:status": "pnpm exec tsx scripts/bootstrap/status.ts",
        "bootstrap:steps": "pnpm exec tsx scripts/bootstrap/progress.ts",
        "build": "pnpm build:contracts",
        "build:artifacts": "mkdir -p scripts/artifacts && cp target/*.json target/*.ts scripts/artifacts",
        "build:bytecode": "pnpm exec tsx scripts/build/bytecode-check.ts",
        "build:circuit": "pnpm exec tsx scripts/build/circuit-info.ts",
        "build:codegen": "aztec codegen ./target -o ./target",
        "build:compile": "pnpm exec tsx scripts/build/compile-times.ts",
        "build:contracts": "pnpm fmt:aztec && pnpm build:compile && pnpm build:codegen && pnpm build:artifacts",
        "clean": "pnpm clean:build && del-cli node_modules",
        "clean:build": "del-cli dist target codegenCache.json scripts/artifacts",
        "clean:runtime": "pnpm exec tsx scripts/clean/clean-runtime.ts",
        "deploy:check": "pnpm exec tsx scripts/deploy/check.ts",
        "deploy:publish": "pnpm exec tsx scripts/deploy/sync.ts",
        "deploy:run": "pnpm exec tsx scripts/deploy/deploy.ts",
        "deploy:start": "pnpm build && pnpm deploy:run && pnpm bootstrap && pnpm deploy:publish",
        "fmt:aztec": "aztec-nargo fmt --workspace",
        "fmt:aztec:check": "aztec-nargo fmt --workspace --check",
        "fmt:aztec:staged": "node -e \"require('child_process').execSync('aztec-nargo fmt --workspace', {stdio:'inherit'})\"",
        "fmt:lint": "eslint .",
        "fmt:lint:fix": "eslint . --fix",
        "fmt:prettier": "prettier --write \"scripts/**/*.{ts,js,json}\"",
        "fmt:prettier:check": "prettier --check \"scripts/**/*.{ts,js,json}\"",
        "fmt:scripts": "pnpm fmt:lint:fix && pnpm fmt:prettier",
        "fmt:scripts:check": "pnpm fmt:prettier:check && pnpm fmt:lint",
        "format": "pnpm fmt:aztec & pnpm fmt:scripts",
        "format:check": "pnpm fmt:aztec:check & pnpm fmt:scripts:check",
        "net:local": "SEQ_BLOCK_DURATION_MS=12000 aztec start --local-network",
        "net:print": "pnpm exec tsx scripts/runtime/network.ts"
    },
    "dependencies": {
        "@dfpunk/hashing": "workspace:*",
        "@dfpunk/utils": "workspace:*"
    },
    "devDependencies": {
        "@eslint/js": "9.39.2",
        "@types/node": "24.10.7",
        "eslint": "9.39.2",
        "eslint-config-prettier": "10.1.8",
        "eslint-plugin-simple-import-sort": "12.1.1",
        "globals": "16.5.0",
        "prettier": "3.7.4",
        "typescript": "5.9.3",
        "typescript-eslint": "8.53.0"
    },
    "packageManager": "pnpm@10.28.0",
    "engines": {
        "node": "24.22.1",
        "pnpm": "10.28.0"
    }
}