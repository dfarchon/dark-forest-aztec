{
    "name": "contracts",
    "version": "0.1.0",
    "description": "",
    "license": "",
    "author": "",
    "type": "module",
    "main": "index.js",
    "scripts": {
        "aztec:fmt": "aztec-nargo fmt --workspace",
        "aztec:fmt:check": "aztec-nargo fmt --workspace --check",
        "aztec:fmt:lint-staged": "node -e \"require('child_process').execSync('aztec-nargo fmt --workspace', {stdio:'inherit'})\"",
        "bridge-fee-juice": "pnpm exec tsx scripts/operator/bridge-fee-juice.ts",
        "build": "pnpm build-contracts",
        "build-contracts": "pnpm aztec:fmt && pnpm compile-contracts && pnpm codegen-contracts && pnpm copy-artifacts",
        "bytecode-check": "pnpm exec tsx scripts/dev/bytecode-check.ts",
        "calibrate-fpc-gas": "pnpm exec tsx scripts/operator/calibrate-gas.ts",
        "circuit-info": "pnpm exec tsx scripts/dev/circuit-info.ts",
        "claim-fee-juice": "pnpm exec tsx scripts/operator/claim-fee-juice.ts",
        "clean": "del-cli dist node_modules target codegenCache.json scripts/artifacts",
        "clean-pxe": "del-cli pxe_data_* wallet_data_* ./scripts/pxe_data_* ./scripts/wallet_data_* .store",
        "clean-store": "del-cli pxe_data_* wallet_data_* ./scripts/pxe_data_* ./scripts/wallet_data_* ./scripts/.test-accounts.json .store",
        "clean:artifacts": "del-cli dist target codegenCache.json scripts/artifacts",
        "codegen-contracts": "aztec codegen ./target -o ./target",
        "compile-contracts": "aztec compile",
        "configure": "pnpm exec tsx scripts/deploy/configure.ts",
        "copy-artifacts": "mkdir -p scripts/artifacts && cp target/*.json target/*.ts scripts/artifacts",
        "deploy-contracts": "pnpm exec tsx scripts/deploy/deploy.ts",
        "deploy-fpc": "pnpm exec tsx scripts/deploy/deploy-fpc.ts",
        "format": "pnpm run aztec:fmt & pnpm run scripts:fmt",
        "format:check": "pnpm run aztec:fmt:check & pnpm run scripts:fmt:check",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "local-network": "SEQ_BLOCK_DURATION_MS=12000 aztec start --local-network",
        "prettier": "prettier --write \"scripts/**/*.{ts,js,json}\"",
        "prettier:check": "prettier --check \"scripts/**/*.{ts,js,json}\"",
        "read:balance": "pnpm exec tsx scripts/read/read-fee-juice-balance.ts",
        "read:config": "pnpm exec tsx scripts/read/read-config.ts",
        "scripts:fmt": "pnpm run lint:fix && pnpm run prettier",
        "scripts:fmt:check": "pnpm prettier:check && pnpm lint",
        "set-zk": "pnpm exec tsx scripts/dev/set-zk.ts",
        "start": "pnpm build && pnpm deploy-contracts && pnpm configure && pnpm sync-env-and-artifacts",
        "sync-env-and-artifacts": "pnpm exec tsx scripts/deploy/sync-env-and-artifacts.ts",
        "test:configure-resume": "pnpm exec tsx scripts/test/test-configure-resume.ts",
        "test:env": "pnpm exec tsx scripts/test/test-env.ts",
        "test:fee-payment": "pnpm exec tsx scripts/test/test-fee-payment.ts",
        "test:moveProof": "pnpm exec tsx scripts/test/test-moveProof.ts",
        "timestamp-ticker": "pnpm exec tsx scripts/dev/timestamp-ticker.ts",
        "update-config": "pnpm exec tsx scripts/dev/update-config.ts",
        "update-fpc-policy": "pnpm exec tsx scripts/operator/update-fpc-policy.ts",
        "verify-perms": "pnpm exec tsx scripts/deploy/verify-storage-permissions.ts"
    },
    "dependencies": {
        "@dfpunk/hashing": "workspace:*",
        "@dfpunk/quota-fpc": "workspace:*",
        "@dfpunk/utils": "workspace:*"
    },
    "devDependencies": {
        "@eslint/js": "9.39.2",
        "@types/node": "24.10.7",
        "eslint": "9.39.2",
        "eslint-config-prettier": "9.1.0",
        "eslint-plugin-simple-import-sort": "12.1.1",
        "globals": "16.5.0",
        "prettier": "3.7.4",
        "typescript": "5.9.3",
        "typescript-eslint": "8.53.0"
    },
    "packageManager": "pnpm@10.28.0"
}
