{
    "name": "contracts",
    "version": "0.0.0",
    "description": "",
    "license": "",
    "author": "",
    "type": "module",
    "main": "index.js",
    "scripts": {
        "aztec:fmt": "aztec fmt",
        "aztec:fmt:check": "aztec fmt --check",
        "build": "pnpm build-contracts",
        "build-contracts": "pnpm clean && pnpm aztec:fmt && pnpm compile-contracts && pnpm codegen-contracts && pnpm copy-artifacts",
        "bytecode-check": "node --experimental-transform-types scripts/bytecode-check.ts",
        "clean": "rm -rf dist target codegenCache.json",
        "codegen-contracts": "aztec codegen ./target -o ./target",
        "compile-contracts": "aztec compile",
        "configure": "node --experimental-transform-types scripts/configure.ts",
        "copy-artifacts": "mkdir -p scripts/artifacts && cp target/*.json target/*.ts scripts/artifacts",
        "deploy-contracts": "pnpm build-contracts && node --experimental-transform-types scripts/deploy.ts",
        "format": "pnpm run lint:fix && pnpm run prettier",
        "format:check": "pnpm prettier:check && pnpm lint",
        "interact": "node --experimental-transform-types scripts/interact.ts",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "prettier": "prettier --write \"scripts/**/*.{ts,js,json}\"",
        "prettier:check": "prettier --check \"scripts/**/*.{ts,js,json}\""
    },
    "dependencies": {},
    "devDependencies": {
        "@eslint/js": "9.39.2",
        "@types/node": "24.10.7",
        "eslint": "9.39.2",
        "eslint-config-prettier": "9.1.0",
        "eslint-plugin-simple-import-sort": "12.1.1",
        "globals": "16.5.0",
        "prettier": "3.7.4",
        "typescript": "5.9.3",
        "typescript-eslint": "8.53.0"
    },
    "packageManager": "pnpm@10.28.0"
}
