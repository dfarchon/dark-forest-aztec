+// Only public call construction uses this path. Keep constrained serialization
+// verbatim; public execution retains each custom serializer in parameter order.
+comptime fn public_serialization(
+    params: [(Quoted, Type)],
+    original: Quoted,
+    name: Quoted,
+) -> Quoted {
+    let mut supported = true;
+    let mut reads: [Quoted] = @[];
+    let mut fields: [Quoted] = @[];
+    for index in 0..params.len() {
+        let (parameter, typ) = params[index];
+        let serialized_type =
+            quote { [Field; <$typ as crate::protocol::traits::Serialize>::N] }.as_type();
+        let width = serialized_type.as_array().unwrap().1.as_constant();
+        if width.is_none() {
+            supported = false;
+        } else {
+            let width = width.unwrap();
+            let array = typ.as_array();
+            let field_array = if array.is_some() {
+                array.unwrap().0.is_field()
+            } else {
+                false
+            };
+            let member = f"serialized_member_{index}".quoted_contents();
+            reads = reads.push_back(
+                if field_array {
+                    quote { let $member = $parameter; }
+                } else {
+                    quote {
+                        let $member = aztec::protocol::traits::Serialize::serialize($parameter);
+                    }
+                },
+            );
+            for offset in 0..width {
+                fields = fields.push_back(quote { $member[$offset] });
+            }
+        }
+    }
+    if supported {
+        let reads = reads.join(quote { });
+        let fields = fields.join(quote { , });
+        quote {
+            let $name = if std::runtime::is_unconstrained() {
+                $reads
+                [$fields]
+            } else {
+                $original
+                $name
+            };
+        }
+    } else {
+        original
+    }
+}
