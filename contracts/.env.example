# Copy to .env. This file only selects the network; other keys here are ignored.
# AZTEC_NETWORK must be one of: local, testnet, mainnet.
# Scripts then read networks/<AZTEC_NETWORK>.env
# (copy networks/<name>.env.example and fill network fields in by hand).
# pnpm account:generate only appends ACCOUNT_* at the end of that file.
AZTEC_NETWORK=local
