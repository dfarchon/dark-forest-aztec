# =============================================================================
# contracts/.env.example  —  template for contracts/ scripts
# =============================================================================
#
# QUICK START
#   1. Copy this file to `.env`:   cp .env.example .env
#   2. Edit ONLY Section 1 below (connection + profile). Leave Sections 2 & 3
#      empty — `pnpm deploy-contracts` / `pnpm configure` fill them in for you.
#   3. Run the scripts. That's it for a simple local setup.
#
# -----------------------------------------------------------------------------
# PICK ONE OF TWO SETUPS
# -----------------------------------------------------------------------------
#
#   SETUP A — Single file (simplest, recommended for local dev)
#     * Leave AZTEC_NETWORK unset.
#     * Everything (settings, account, deployed addresses) lives in `.env`.
#     * You only ever touch one file: `.env`.
#
#   SETUP B — Multiple networks (e.g. switch between devnet / testnet)
#     * In `.env`, set AZTEC_NETWORK=devnet  (acts as a pointer + shared base).
#     * ALSO create a per-network file, e.g. `cp .env.example .env.devnet`.
#     * Put network-specific values (node URL, account, addresses) in
#       `.env.devnet`. Deploy/configure output is written there, not to `.env`.
#     * To switch network: change AZTEC_NETWORK in `.env` (or export it in your
#       shell), and have the matching `.env.<network>` file present.
#
# -----------------------------------------------------------------------------
# HOW LOADING WORKS  (contracts/scripts/utils/env.ts → loadContractsEnv)
# -----------------------------------------------------------------------------
#   `.env` is NOT just a pointer — it is a BASE layer that is ALWAYS loaded.
#
#   Step 1: `.env` is loaded first (so AZTEC_NETWORK / CONTRACTS_ENV_FILE are known).
#   Step 2: the "active" file is resolved and loaded ON TOP (it overrides `.env`):
#             a. CONTRACTS_ENV_FILE if set (absolute, or relative to cwd), else
#             b. `.env.<AZTEC_NETWORK>` if AZTEC_NETWORK is set AND that file exists, else
#             c. `.env` itself  ← this is Setup A
#   Step 3: ALL deploy/configure output is written to the ACTIVE file
#             (Setup A → `.env`;  Setup B → `.env.<network>`).
#
#   Within one file, the LAST occurrence of a key wins (dotenv), so deploy may
#   append fresh ACCOUNT_* / address blocks at the bottom; older lines can stay.
#
# -----------------------------------------------------------------------------
# SECURITY — read before committing anything
# -----------------------------------------------------------------------------
#   - Only `.env.example` is tracked by git. `.env` and every `.env.*`
#     (e.g. `.env.local`, `.env.devnet`, `.env.testnet`) are gitignored — keep it that way.
#   - ACCOUNT_SECRET_KEY and ACCOUNT_SIGNING_KEY are REAL PRIVATE KEYS. Never paste
#     real values into this template, never commit them, never share them.
#   - This file (.env.example) must only ever contain empty placeholders / dummy values.
# =============================================================================


# -----------------------------------------------------------------------------
# 1. CONNECTION & PROFILE  — set these by hand (the only section you edit)
# -----------------------------------------------------------------------------

# Aztec node RPC. Default (if unset): http://localhost:8080
AZTEC_NODE_URL=http://localhost:8080
# Devnet / testnet examples (uncomment one; for Setup B put it in `.env.<network>`):
# AZTEC_NODE_URL=https://testnet.rpc-aztec-labs.com

# L1 RPC — only used by L1-aware scripts (e.g. pnpm debug-timestamp).
# Default (if unset): http://localhost:8545
# ETHEREUM_HOST=http://localhost:8545

# Network profile label: local | devnet | testnet.  (See "PICK ONE OF TWO SETUPS" above.)
#   - Setup A (single file): LEAVE THIS UNSET → everything stays in `.env`.
#   - Setup B (multi network): set it AND create a matching `contracts/.env.<value>`
#     file. That file is then layered on top of `.env`, and all deploy/configure
#     output is written there. If the file does NOT exist, this label is ignored
#     and the loader falls back to `.env`.
# AZTEC_NETWORK=local

# Escape hatch: force one specific env file (absolute path, or relative to cwd).
# When set, this WINS over the AZTEC_NETWORK selection above. Most people leave it blank.
# CONTRACTS_ENV_FILE=

# Prover. Omit for sensible defaults: OFF on localhost, ON for remote nodes.
# Override with `true` (force on locally) or `false` (force off remotely).
# PROVER_ENABLED=false

# Set false to stop scripts appending deploy/account output to the active env file.
# WRITE_ENV_FILE=true

# Suppress the printed account/env summary when loading keys.
# ACCOUNT_SILENT_DIAGNOSTICS=true


# -----------------------------------------------------------------------------
# 2. ACCOUNT (deployer)  — auto-written by deploy; do NOT hand-edit
# -----------------------------------------------------------------------------
# Leave these empty: `pnpm deploy-contracts` creates the account, deploys it, and
# appends the four keys below to the active env file. To reuse an existing
# account, paste a matching set (ACCOUNT_ADDRESS must derive from the keys).
#
# !!! ACCOUNT_SECRET_KEY and ACCOUNT_SIGNING_KEY ARE PRIVATE KEYS — never commit !!!
# ACCOUNT_SALT=
# ACCOUNT_SECRET_KEY=
# ACCOUNT_SIGNING_KEY=
# ACCOUNT_ADDRESS=


# -----------------------------------------------------------------------------
# 3. DEPLOYMENT OUTPUT  — auto-written by deploy/configure; do NOT hand-edit
# -----------------------------------------------------------------------------
# Block anchor recorded at deploy time (client indexer start block).
# START_BLOCK=

# For each contract the deploy script writes three keys:
#   *_CONTRACT_ADDRESS   deployed instance address
#   *_DEPLOYER_ADDRESS   account that deployed it
#   *_DEPLOYMENT_SALT    salt used (for address recomputation)

# CONFIG_CONTRACT_ADDRESS=
# CONFIG_DEPLOYER_ADDRESS=
# CONFIG_DEPLOYMENT_SALT=

# WORLD_STORAGE_CONTRACT_ADDRESS=
# WORLD_STORAGE_DEPLOYER_ADDRESS=
# WORLD_STORAGE_DEPLOYMENT_SALT=

# PLAYER_STORAGE_CONTRACT_ADDRESS=
# PLAYER_STORAGE_DEPLOYER_ADDRESS=
# PLAYER_STORAGE_DEPLOYMENT_SALT=

# PLANET_STORAGE_CONTRACT_ADDRESS=
# PLANET_STORAGE_DEPLOYER_ADDRESS=
# PLANET_STORAGE_DEPLOYMENT_SALT=

# PLANET_REVEALED_COORDS_STORAGE_CONTRACT_ADDRESS=
# PLANET_REVEALED_COORDS_STORAGE_DEPLOYER_ADDRESS=
# PLANET_REVEALED_COORDS_STORAGE_DEPLOYMENT_SALT=

# PLANET_EVENTS_STORAGE_CONTRACT_ADDRESS=
# PLANET_EVENTS_STORAGE_DEPLOYER_ADDRESS=
# PLANET_EVENTS_STORAGE_DEPLOYMENT_SALT=

# PLANET_ARTIFACTS_STORAGE_CONTRACT_ADDRESS=
# PLANET_ARTIFACTS_STORAGE_DEPLOYER_ADDRESS=
# PLANET_ARTIFACTS_STORAGE_DEPLOYMENT_SALT=

# ARRIVAL_STORAGE_CONTRACT_ADDRESS=
# ARRIVAL_STORAGE_DEPLOYER_ADDRESS=
# ARRIVAL_STORAGE_DEPLOYMENT_SALT=

# ARTIFACT_STORAGE_CONTRACT_ADDRESS=
# ARTIFACT_STORAGE_DEPLOYER_ADDRESS=
# ARTIFACT_STORAGE_DEPLOYMENT_SALT=

# ARTIFACT_LOCATION_STORAGE_CONTRACT_ADDRESS=
# ARTIFACT_LOCATION_STORAGE_DEPLOYER_ADDRESS=
# ARTIFACT_LOCATION_STORAGE_DEPLOYMENT_SALT=

# ADMIN_CONTRACT_ADDRESS=
# ADMIN_DEPLOYER_ADDRESS=
# ADMIN_DEPLOYMENT_SALT=

# CORE_CONTRACT_ADDRESS=
# CORE_DEPLOYER_ADDRESS=
# CORE_DEPLOYMENT_SALT=

# MOVE_CONTRACT_ADDRESS=
# MOVE_DEPLOYER_ADDRESS=
# MOVE_DEPLOYMENT_SALT=

# ARTIFACT_ACTION_SYSTEM_CONTRACT_ADDRESS=
# ARTIFACT_ACTION_SYSTEM_DEPLOYER_ADDRESS=
# ARTIFACT_ACTION_SYSTEM_DEPLOYMENT_SALT=

# ARTIFACT_FIND_SYSTEM_CONTRACT_ADDRESS=
# ARTIFACT_FIND_SYSTEM_DEPLOYER_ADDRESS=
# ARTIFACT_FIND_SYSTEM_DEPLOYMENT_SALT=

# ARTIFACT_PROSPECT_SYSTEM_CONTRACT_ADDRESS=
# ARTIFACT_PROSPECT_SYSTEM_DEPLOYER_ADDRESS=
# ARTIFACT_PROSPECT_SYSTEM_DEPLOYMENT_SALT=

# ARTIFACT_VAULT_SYSTEM_CONTRACT_ADDRESS=
# ARTIFACT_VAULT_SYSTEM_DEPLOYER_ADDRESS=
# ARTIFACT_VAULT_SYSTEM_DEPLOYMENT_SALT=
