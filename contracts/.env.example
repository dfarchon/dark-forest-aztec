# Copy to `.env` (or use profile files — see CLAUDE.md "Contracts env").
# Duplicate keys: the LAST occurrence of each key in this file wins (dotenv parse). You may append new ACCOUNT_* blocks; older lines can stay.

# -----------------------------------------------------------------------------
# Network profile (optional)
# -----------------------------------------------------------------------------
# Label for logs / docs: local | devnet | testnet
# If set here (or in the shell) AND `contracts/.env.<AZTEC_NETWORK>` exists, that file is loaded on top of `.env`.
# All deploy outputs (ACCOUNT_*, contract addresses, START_BLOCK) are written to the network-specific file.
# AZTEC_NETWORK=devnet

# Force a specific env file (absolute path, or path relative to cwd). Overrides profile selection.
# CONTRACTS_ENV_FILE=

# -----------------------------------------------------------------------------
# Connection (scripts read these via contracts/scripts/utils/env.ts)
# -----------------------------------------------------------------------------
AZTEC_NODE_URL=http://localhost:8080
# L1 RPC when scripts need it (e.g. debug-timestamp)
ETHEREUM_HOST=http://localhost:8545

# Prover: omit for defaults — off on localhost unless PROVER_ENABLED=true; on remote nodes on unless PROVER_ENABLED=false
# PROVER_ENABLED=false

# Append deploy/account lines to the env file (default true). Set false to skip writes.
# WRITE_ENV_FILE=true

# -----------------------------------------------------------------------------
# Account (filled by deploy / wallet helpers)
# -----------------------------------------------------------------------------
# ACCOUNT_SALT=
# ACCOUNT_SECRET_KEY=
# ACCOUNT_SIGNING_KEY=
# ACCOUNT_ADDRESS=

# Suppress printed account summary (network, on-chain, local PXE) when loading keys.
# ACCOUNT_SILENT_DIAGNOSTICS=true

# -----------------------------------------------------------------------------
# Deployment (filled by pnpm deploy-contracts; block anchor from deploy)
# -----------------------------------------------------------------------------
# START_BLOCK=

# CONFIG_CONTRACT_ADDRESS=
# CONFIG_DEPLOYER_ADDRESS=
# CONFIG_DEPLOYMENT_SALT=

# WORLD_STORAGE_CONTRACT_ADDRESS=
# WORLD_STORAGE_DEPLOYER_ADDRESS=
# WORLD_STORAGE_DEPLOYMENT_SALT=

# PLAYER_STORAGE_CONTRACT_ADDRESS=
# PLAYER_STORAGE_DEPLOYER_ADDRESS=
# PLAYER_STORAGE_DEPLOYMENT_SALT=

# PLANET_STORAGE_CONTRACT_ADDRESS=
# PLANET_STORAGE_DEPLOYER_ADDRESS=
# PLANET_STORAGE_DEPLOYMENT_SALT=

# PLANET_REVEALED_COORDS_STORAGE_CONTRACT_ADDRESS=
# PLANET_REVEALED_COORDS_STORAGE_DEPLOYER_ADDRESS=
# PLANET_REVEALED_COORDS_STORAGE_DEPLOYMENT_SALT=

# PLANET_EVENTS_STORAGE_CONTRACT_ADDRESS=
# PLANET_EVENTS_STORAGE_DEPLOYER_ADDRESS=
# PLANET_EVENTS_STORAGE_DEPLOYMENT_SALT=

# PLANET_ARTIFACTS_STORAGE_CONTRACT_ADDRESS=
