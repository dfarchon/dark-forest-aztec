# Copy to .env and configure.

# Aztec node URL (local sandbox, devnet, testnet or mainnet).
# AZTEC_NODE_URL=http://localhost:8080

# Optional: set to false only for fast local sandbox deploy (proofs disabled).
# PROVER_ENABLED=true

# Optional: SponsoredFPC when the network uses a non-canonical deployment (e.g. public testnet).
# Scripts load the contract from chain at this address for PXE registration and fees.
# Match client/.env VITE_SPONSORED_FPC_ADDRESS when using the same network.
# SPONSORED_FPC_ADDRESS=
