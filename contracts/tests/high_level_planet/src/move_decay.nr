// Checks the contract's move decay against the frontend's, row by row.
// The table is generated by scripts/check/move-decay-vectors.ts; see `pnpm test:decay-match`.
use ::libs::move_decay::decayed_pop_arriving;

use crate::move_decay_vectors::MOVE_DECAY_VECTORS;

#[test]
unconstrained fn matches_client_vectors() {
    for i in 0..MOVE_DECAY_VECTORS.len() {
        let (pop, cap, range, dist, expected) = MOVE_DECAY_VECTORS[i];
        let actual = decayed_pop_arriving(pop, cap, range, dist);
        assert(
            actual == expected,
            f"row {i}: pop={pop} cap={cap} range={range} dist={dist}: contract {actual}, client {expected}",
        );
    }
}
