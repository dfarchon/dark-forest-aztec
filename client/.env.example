# Copy to .env and set as needed. Only VITE_* variables are exposed to the client.

# Aztec node URL (blockchain connection).
VITE_AZTEC_NODE_URL=http://localhost:8080

# Optional: off-chain indexer API base URL for bootstrap snapshot.
# In devnet build, defaults to devnet server (https://server-production-b4e5.up.railway.app) when unset.
# Leave unset in dev to sync from node (START_BLOCK), or set to local server (e.g. http://localhost:3001).
# VITE_INDEXER_BOOTSTRAP_URL=

# Default setting behavior: production | development. Drives onboarding/tutorial defaults.
# production => NewPlayer, TutorialOpen etc. default "true"; development => "false".
# When unset, Vite's import.meta.env.MODE is used.
# VITE_APP_MODE=development

# Enable client-side proof generation (required for devnet/testnet, optional for local).
# Set to "true" for devnet/testnet; keep "false" for faster local development.
VITE_PROVER_ENABLED=false

# Aztec accelerator (TeeRex-style prover) HTTP base URL used by wallet/game/tx-executor.
# Local default is http://127.0.0.1:59833 (matches aztec-accelerator default port).
# Connection settings in UI can override this via localStorage at runtime.
VITE_TEEREX_PROVER_URL=http://127.0.0.1:59833
