# Copy to .env and set as needed. Only VITE_* variables are exposed to the client.

# Aztec node URL (blockchain connection).
VITE_AZTEC_NODE_URL=http://localhost:8080

# Optional: off-chain indexer API base URL for bootstrap snapshot.
# In testnet build, defaults to testnet server when unset.
# Leave unset in dev to sync from node (START_BLOCK), or set to local server (e.g. http://localhost:3001).
# VITE_INDEXER_BOOTSTRAP_URL=

# Default setting behavior: production | development. Drives onboarding/tutorial defaults.
# production => NewPlayer, TutorialOpen etc. default "true"; development => "false".
# When unset, Vite's import.meta.env.MODE is used.
# VITE_APP_MODE=development

# Enable client-side proof generation (required for devnet/testnet, optional for local).
# Set to "true" for devnet/testnet; keep "false" for faster local development.
VITE_PROVER_ENABLED=false

# Aztec accelerator (TeeRex-style prover) HTTP base URL used by wallet/game/tx-executor.
# Local default is http://127.0.0.1:59833 (matches aztec-accelerator default port).
# Connection settings in UI can override this via localStorage at runtime.
VITE_TEEREX_PROVER_URL=http://127.0.0.1:59833

# ---------------------------------------------------------------------------
# Sponsored transactions (quota paymaster)
# ---------------------------------------------------------------------------
# Address of a deployed QuotaFpc. THIS SINGLE VARIABLE turns sponsorship on:
# unset, the client behaves exactly as it does without the paymaster and players
# pay their own fees. Set, new players can play without bridging $AZTEC first,
# up to the paymaster's daily allowance, after which they fall back to paying.
#
# Try the live mainnet demo paymaster (funded, ready to use):
# VITE_QUOTA_FPC_ADDRESS=0x0572042f6b9a6e6d33077a15c203ca81006ae162eab322efe32eeaffff5729d4
#
# For production deploy your own — the admin address is fixed at deployment and
# cannot be transferred, so it is only yours if you deploy it:
#   pnpm --filter contracts run deploy-fpc -- --config fpc/config/dark-forest.json
#
# Verbose sponsorship diagnostics in the browser console ([quota] prefix):
# which path each transaction took, what the allowance said, what the fee was.
# VITE_QUOTA_DEBUG=true
#
# How long to wait for the wallet to observe an updated allowance before
# reporting it as "still checking" (ms). Never used to conclude a player is out
# of free transactions.
# VITE_QUOTA_SYNC_TIMEOUT_MS=20000

# Minimum active-account FeeJuice (human-readable FJ) when quota sponsorship
# is unavailable or exhausted.
# Default is 5 FJ when unset.
# VITE_ACCOUNT_MIN_BALANCE_FJ=5
