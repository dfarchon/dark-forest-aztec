{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "baseUrl": ".",
    "paths": {
      "@alejoamiras/aztec-accelerator": [
        "./node_modules/@alejoamiras/aztec-accelerator/dist/src/index.d.ts"
      ]
    },
    "strict": true,
    "strictPropertyInitialization": false,
    "useUnknownInCatchVariables": false,
    "skipLibCheck": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "types": ["vite/client"]
  },
  "include": ["src"],
  "exclude": [
    "src/Frontend/Panes/Lobbies",
    "src/Frontend/Pages/LobbyLandingPage.tsx",
    "src/Frontend/Game/Popups.ts"
  ]
}
