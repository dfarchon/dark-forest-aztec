{
  "name": "client",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -b && vite build",
    "clean": "del-cli dist node_modules .vite",
    "deploy:prod": "pnpm build && netlify deploy --prod",
    "dev": "vite",
    "format": "pnpm run lint:fix && pnpm run prettier",
    "format:check": "pnpm prettier:check && pnpm lint",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "prettier": "prettier --write \"src/**/*.{ts,tsx,js,jsx,json,css,md}\"",
