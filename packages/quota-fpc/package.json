{
  "name": "@dfpunk/quota-fpc",
  "version": "0.1.0",
  "description": "Client logic for the QuotaFpc paymaster: sandwich transaction assembly, per-day allowance state, and fee-source resolution",
  "keywords": [],
  "license": "",
  "author": "",
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "del-cli dist node_modules",
    "format": "prettier --write \"src/**/*.{ts,tsx,js,jsx,json}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,js,jsx,json}\"",
    "fund:local": "tsx scripts/fund-local.ts",
    "test": "vitest run",
    "test:integration": "vitest run test/integration"
  },
  "dependencies": {
    "@aztec/aztec.js": "5.0.1",
    "@aztec/entrypoints": "5.0.1",
    "@aztec/ethereum": "5.0.1",
    "@aztec/foundation": "5.0.1",
    "@aztec/stdlib": "5.0.1",
    "@aztec/wallets": "5.0.1"
  },
  "devDependencies": {
    "prettier": "3.7.4",
    "tsx": "4.21.0",
    "typescript": "5.9.3",
    "vitest": "3.2.4"
  },
  "packageManager": "pnpm@10.28.0"
}
