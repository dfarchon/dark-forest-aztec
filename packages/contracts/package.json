{
  "name": "@dfpunk/contracts",
  "version": "0.0.0",
  "description": "Contract addresses, deployment constants, and helpers for dfpunk-aztec",
  "keywords": [],
  "license": "",
  "author": "",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./PlayerStorage": {
      "types": "./src/artifacts/PlayerStorage.ts",
      "import": "./dist/artifacts/PlayerStorage.js",
      "default": "./dist/artifacts/PlayerStorage.js"
    },
    "./artifacts/PlayerStorage": {
      "types": "./src/artifacts/PlayerStorage.ts",
      "import": "./dist/artifacts/PlayerStorage.js",
      "default": "./dist/artifacts/PlayerStorage.js"
    },
    "./ArtifactStorage": {
      "types": "./src/artifacts/ArtifactStorage.ts",
      "import": "./dist/artifacts/ArtifactStorage.js",
      "default": "./dist/artifacts/ArtifactStorage.js"
    },
    "./artifacts/ArtifactStorage": {
      "types": "./src/artifacts/ArtifactStorage.ts",
      "import": "./dist/artifacts/ArtifactStorage.js",
      "default": "./dist/artifacts/ArtifactStorage.js"
    }
  },
  "main": "dist/index.js",
  "types": "src/index.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "format": "prettier --write \"src/**/*.{ts,tsx,js,jsx,json}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,js,jsx,json}\""
  },
  "devDependencies": {
    "prettier": "3.7.4",
    "typescript": "5.9.3"
  },
  "packageManager": "pnpm@10.28.0"
}
