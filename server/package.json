{
  "name": "server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "clean": "del-cli dist node_modules data",
    "dev": "node --experimental-transform-types src/index.ts",
    "e2e:down": "bash scripts/test-env.sh stop",
    "e2e:fast": "bash scripts/test-env.sh e2e-start-fast",
    "e2e:logs": "bash scripts/test-env.sh e2e-logs",
    "e2e:reset": "bash scripts/test-env.sh reset-cache",
    "e2e:runtime": "bash scripts/test-env.sh start",
    "e2e:start": "bash scripts/test-env.sh e2e-start",
    "e2e:start-all": "bash scripts/test-env.sh start-all",
    "e2e:status": "bash scripts/test-env.sh status",
    "e2e:stop": "bash scripts/test-env.sh e2e-stop",
    "e2e:up": "bash scripts/test-env.sh up",
    "format": "prettier --write \"src/**/*.{ts,js,json}\"",
    "format:check": "prettier --check \"src/**/*.{ts,js,json}\"",
    "mock:snapshot": "node scripts/mock-big-snapshot-stream-server.mjs",
    "start": "node --experimental-transform-types src/index.ts",
    "test:init-player:safe": "node --experimental-transform-types scripts/test-core-initialize-player-safe.mjs"
  },
  "dependencies": {
    "@dfpunk/contracts": "workspace:*",
    "@hono/node-server": "^1.13.8",
    "better-sqlite3": "^11.8.1",
    "hono": "^4.7.4"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "prettier": "3.7.4",
    "typescript": "5.9.3"
  },
  "packageManager": "pnpm@10.28.0"
}
