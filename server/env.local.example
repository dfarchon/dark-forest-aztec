# Local server process for devnet sync + local frontend/API usage.

# Remote Aztec devnet node to read public events from.
AZTEC_NODE_URL=https://v4-devnet-2.aztec-labs.com

# Allow both local frontend origins and the deployed Netlify frontend.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://df-aztec.netlify.app

# Optional. Leave commented unless you need to override the baked START_BLOCK.
# INDEXER_START_BLOCK=32202

# Local HTTP port for the indexer API.
PORT=3001

# Local SQLite snapshot path.
SQLITE_PATH=./data/indexer-devnet.db

# Minimum seconds between persisted snapshot writes.
PERSIST_MIN_INTERVAL_SEC=10

# Optional. Enables GET /admin/backup when set.
ADMIN_TOKEN=
