# Generic server example. See .env.local.example and .env.railway.example for
# copy/paste-ready presets.

# Aztec node URL. Default runtime target is the remote testnet; use
# http://localhost:8080 only when you intentionally run a local sandbox.
AZTEC_NODE_URL=https://canonical.testnet.rpc.aztec-labs.com/

# Optional backup RPC endpoints for automatic failover.
# Comma-separated list; cascades primary → backup1 → backup2 → ...
# AZTEC_NODE_URL_BACKUP=https://backup1.example,https://backup2.example

# Allowed browser origins for snapshot/health APIs (comma-separated).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://dark-forest-aztec-testnet-v5.netlify.app,https://dfpunk-aztec.netlify.app

# Optional indexer start block override. Defaults to START_BLOCK from @dfpunk/contracts.
# INDEXER_START_BLOCK=32202

# HTTP server port
PORT=3001

# SQLite database file path (Railway: mount Volume to this directory)
SQLITE_PATH=./data/indexer.db

# Snapshot JSON schema version. Bump this when client/server snapshot shape changes.
# On mismatch, persisted snapshot is reset and rebuilt from chain.
SNAPSHOT_SCHEMA_VERSION=1

# Minimum interval between SQLite persists (seconds)
PERSIST_MIN_INTERVAL_SEC=10

# Admin token for /admin/backup endpoint (empty = disabled)
ADMIN_TOKEN=
