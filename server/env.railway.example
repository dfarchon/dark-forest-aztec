# Railway service example for a devnet-backed indexer deployment.

# Aztec devnet RPC / node endpoint.
AZTEC_NODE_URL=https://canonical.testnet.rpc.aztec-labs.com/

# Optional backup RPC endpoints for automatic failover.
# Comma-separated list; cascades primary → backup1 → backup2 → ...
# AZTEC_NODE_URL_BACKUP=https://backup1.example,https://backup2.example

# Browser origins allowed to fetch snapshot / health APIs.
CORS_ORIGINS=https://dark-forest-aztec-testnet-v5.netlify.app,https://dfpunk-aztec.netlify.app,https://dfpunk-aztec-testnet.netlify.app/

# Railway should usually inject PORT for you. Leave unset unless you have a
# specific reason to override the listener port.
# PORT=3001

# Mount a persistent volume at /data and keep SQLite there.
SQLITE_PATH=/data/indexer.db

# Snapshot JSON schema version (bump to force full rebuild on deploy).
SNAPSHOT_SCHEMA_VERSION=1

# Minimum seconds between persisted snapshot writes.
PERSIST_MIN_INTERVAL_SEC=10

# Optional. Enables GET /admin/backup when set.
# ADMIN_TOKEN=change-me

# Optional. Leave commented unless you need to override the baked START_BLOCK.
# INDEXER_START_BLOCK=32202
