# Aztec mainnet node and Ethereum L1 RPC.
AZTEC_NODE_URL=
ETHEREUM_HOST=

# Created by `pnpm quote` when absent. Do not commit this file.
L1_PRIVATE_KEY=
L1_ADDRESS=

# Created by `pnpm quote` when absent. Reuse an existing account by filling all four values.
AZTEC_ACCOUNT_SALT=
AZTEC_ACCOUNT_SECRET_KEY=
AZTEC_ACCOUNT_SIGNING_KEY=
AZTEC_ACCOUNT_ADDRESS=

# Optional: percentage buffer applied to estimated L1 gas. Default: 25.
ETH_GAS_BUFFER_PERCENT=25
