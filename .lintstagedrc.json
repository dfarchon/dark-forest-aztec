{
  "client/**/*.{ts,tsx,js,jsx,json,css,md}": ["pnpm --filter client format"],
  "packages/**/*.{ts,tsx,js,jsx,json}": [
    "pnpm --filter \"./packages/*\" run format"
  ],
  "contracts/scripts/**/*.{ts,js,json}": ["pnpm --filter contracts format"],
  "contracts/**/*.nr": ["pnpm run format:nr"],
  "**/package.json": ["pnpm fix:package-json"]
}
