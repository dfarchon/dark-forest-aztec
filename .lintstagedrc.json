{
  "client/**/*.{ts,tsx,js,jsx,json,css,md}": ["pnpm --filter client format"],
  "packages/**/*.{ts,tsx,js,jsx,json}": ["prettier --write"],
  "contracts/scripts/**/*.{ts,js,json}": [
    "pnpm --filter contracts fmt:scripts"
  ],
  "contracts/**/*.nr": ["pnpm --filter contracts run fmt:aztec:staged"],
  "**/package.json": ["pnpm fix:package-json"]
}
